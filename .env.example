# Azure OpenAI v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
DEPLOYMENT_AZURE=OAIXXX05
DEPLOYMENT_EMB_SMALL=OAIXXX04

# Admin-managed FileStore knowledge
RAG_KNOWLEDGE_BASE_DIR=/dbfs/FileStore/gestor_obs/knowledge

# Admin-only model and retrieval tuning
# Sent to Responses API as reasoning={"effort": "high"}
RAG_REASONING_EFFORT=high
RAG_TOP_K_EVIDENCE=8
RAG_TOP_K_GLOBAL_CONTEXT=4
RAG_TOP_K_GLOSSARY=5
RAG_MAX_PROMPT_FILES=4
RAG_MAX_PROMPT_IMAGES=2
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=200
