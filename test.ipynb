   "source": [
    "from typing import Any, Dict, List, Optional\n",
    "\n",
    "def safe_text(value: Any) -> str:\n",
    "    if value is None:\n",
    "        return \"\"\n",
    "    return str(value).replace(\"\\x00\", \"\").strip()"
   ]
  },
